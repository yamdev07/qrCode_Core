VITE_APP_ENV=development

# Adresse publique encodée dans les QR codes.
# Laissé vide en dev : on retombe sur l'origine du navigateur (utile pour tester
# depuis un téléphone sur le même LAN). En production, c'est .env.production qui
# fixe https://qrcode.anyxtech.com.
# Décommenter pour générer des QR pointant sur la prod depuis le poste local :
# VITE_PUBLIC_URL=https://qrcode.anyxtech.com
