# ============================================================
# CLIENT ENVIRONMENT VARIABLES
# Copy this file to .env and fill in your values
# .env is gitignored and will NOT be committed
# ============================================================

# Environment mode (development | production)
VITE_APP_ENV=

# Backend API URL — where the Express server is reachable
# Leave empty in dev to use the Vite proxy (phone access works)
# Set to full URL for direct access (e.g. http://10.166.7.162:4000)
VITE_API_URL=

# Frontend app URL — used for QR code links and card page URLs
# Set to your network IP for phone access (e.g. http://10.166.7.162:5173)
# Leave empty to auto-detect from browser URL (window.location.origin)
VITE_APP_URL=
