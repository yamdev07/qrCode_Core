{
  "name": "qrcode-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "lint": "eslint . --ext .vue,.ts --fix",
    "format": "prettier --write \"src/**/*.{vue,ts,css}\"",
    "type-check": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.39.7",
    "consola": "^3.2.3",
    "jsqr": "^1.4.0",
    "ofetch": "^1.3.3",
    "pinia": "^2.1.7",
    "primevue": "^4.0.0",
    "qrcode": "^1.5.3",
    "tesseract.js": "^7.0.0",
    "vue": "^3.4.21",
    "vue-router": "^4.3.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.19",
    "@types/qrcode": "^1.5.5",
    "@typescript-eslint/eslint-plugin": "^7.0.2",
    "@typescript-eslint/parser": "^7.0.2",
    "@vitejs/plugin-vue": "^5.0.4",
    "@vue/test-utils": "^2.4.4",
    "autoprefixer": "^10.4.17",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.22.0",
    "happy-dom": "^13.6.2",
    "postcss": "^8.4.35",
    "prettier": "^3.2.5",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.4.2",
    "vite": "^5.2.0",
    "vite-plugin-pwa": "^0.19.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^1.3.1",
    "vue-tsc": "^2.0.6",
    "workbox-window": "^7.4.1"
  }
}
