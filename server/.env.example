# ============================================================
# SERVER ENVIRONMENT VARIABLES
# Copy this file to .env and fill in your values
# .env is gitignored and will NOT be committed
# ============================================================

# Express server port
PORT=

# Server's own public URL (used in console output and CORS)
# Set to your network IP for phone access (e.g. http://10.166.7.162:4000)
APP_URL=

# PostgreSQL connection
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
